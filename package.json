{
  "name": "demo-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:local": "tsc --noEmit && FILE_LOCAL=true vite build",
    "build:pages": "tsc --noEmit && GITHUB_PAGES=true vite build",
    "preview": "vite preview",
    "open": "npm run build:local && open dist/index.html",
    "serve": "npm run build:local && node scripts/serve-local.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
